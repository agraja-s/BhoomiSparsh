                      "parameters":  {
                                         "jsCode":  "const v = $(\u0027Validate Request\u0027).first().json;\nconst a = $(\u0027Lookup Assessment\u0027).first().json;\nconst ex = $input.first().json || {};\n\nif (ex.error) {\n  return [{ json: { isNew: false, httpStatus: 500, response: { error: { code: \u0027DATABASE_ERROR\u0027, message: \u0027Feedback could not be checked for duplicates. Please try again.\u0027, requestId: v.feedbackId } } } }];\n}\nif (ex.id) {\n  return [{ json: { isNew: false, httpStatus: 200, response: { feedbackId: ex.id, assessmentId: v.assessmentId, status: \u0027duplicate\u0027, message: \u0027Identical feedback was already recorded for this assessment; nothing new was saved.\u0027, verificationStatus: ex.verification_status || null, evaluationEligible: ex.evaluation_eligible === true } } }];\n}\nfunction parse(x) {\n  if (typeof x === \u0027string\u0027) { try { return JSON.parse(x); } catch (e) { return null; } }\n  return x === undefined ? null : x;\n}\nconst diagnosis = parse(a.diagnosis);\nconst weather = parse(a.weather);\nconst risk = parse(a.risk_assessment);\nconst advisory = parse(a.advisory);\n\nconst VERIFICATION = { expert_verified: \u0027expert_verified\u0027, farmer_report: \u0027unverified_farmer_report\u0027, field_observed: \u0027unverified_field_observation\u0027 };\nconst blockers = [];\nif (v.labelSource !== \u0027expert_verified\u0027) blockers.push(\u0027Label is not expert-verified (farmer reports and field observations are not treated as ground truth).\u0027);\nif (v.diseaseObserved === \u0027unknown\u0027) blockers.push(\u0027Disease outcome is unknown.\u0027);\nif (v.diseaseObserved === \u0027true\u0027 \u0026\u0026 !v.confirmedDisease) blockers.push(\u0027confirmedDisease is required when disease was observed.\u0027);\nif (!(a.status === \u0027completed\u0027 || a.status === \u0027partial\u0027)) blockers.push(\u0027Original assessment did not complete (status: \u0027 + a.status + \u0027).\u0027);\nif (!diagnosis || diagnosis.status === \u0027failed\u0027) blockers.push(\u0027Original image-analysis result is missing or failed.\u0027);\nif (!weather || weather.status === \u0027unavailable\u0027 || !Array.isArray(weather.hourly) || weather.hourly.length === 0) blockers.push(\u0027Forecast available at assessment time is missing.\u0027);\nif (!risk || risk.status === undefined) blockers.push(\u0027Original risk assessment is missing.\u0027);\nelse if (risk.status !== \u0027calculated\u0027 \u0026\u0026 risk.status !== \u0027ok\u0027) blockers.push(\u0027No calculated risk timeline exists for the original assessment (risk status: \u0027 + risk.status + \u0027).\u0027);\nif (!a.model_name \u0026\u0026 !a.risk_rule_version) blockers.push(\u0027Model and rule versions are missing.\u0027);\nconst eligible = blockers.length === 0;\n\nconst evaluationCase = {\n  schemaVersion: 1,\n  assessmentId: v.assessmentId,\n  feedbackId: v.feedbackId,\n  capturedAt: v.receivedAt,\n  original: {\n    cropType: a.crop_type || null,\n    growthStage: a.growth_stage || null,\n    latitude: a.latitude === undefined ? null : a.latitude,\n    longitude: a.longitude === undefined ? null : a.longitude,\n    assessedAt: a.created_at || null,\n    prediction: { diagnosisStatus: diagnosis ? diagnosis.status : null, candidates: diagnosis ? (diagnosis.candidates || []) : [], riskStatus: risk ? risk.status : null, advisoryLevel: advisory ? advisory.level : null },\n    imageAnalysis: diagnosis,\n    weatherForecast: weather,\n    riskTimeline: risk ? { curve: risk.curve || [], missingInputs: risk.missingInputs || [] } : null,\n    versions: { diagnosisModel: a.model_name || null, riskModel: a.model_version || null, riskRule: a.risk_rule_version || null }\n  },\n  observation: {\n    labelSource: v.labelSource,\n    verificationStatus: VERIFICATION[v.labelSource],\n    observedCropType: v.observedCropType,\n    confirmedDisease: v.confirmedDisease,\n    diseaseObserved: v.diseaseObserved,\n    outcomeStatus: v.outcomeStatus,\n    daysAfterAssessment: v.daysAfterAssessment\n  },\n  eligibleForFormalEvaluation: eligible,\n  eligibilityBlockers: blockers\n};\n\nreturn [{ json: {\n  isNew: true,\n  id: v.feedbackId,\n  assessment_id: v.assessmentId,\n  label_source: v.labelSource,\n  verification_status: VERIFICATION[v.labelSource],\n  observed_crop_type: v.observedCropType,\n  confirmed_disease: v.confirmedDisease,\n  disease_observed: v.diseaseObserved,\n  outcome_status: v.outcomeStatus,\n  days_after_assessment: v.daysAfterAssessment,\n  farmer_found_advisory_helpful: v.farmerFoundAdvisoryHelpful,\n  notes: v.notes,\n  payload_hash: v.payloadHash,\n  evaluation_eligible: eligible,\n  evaluation_blockers: blockers,\n  evaluation_case: evaluationCase,\n  created_at: v.receivedAt\n} }];"
