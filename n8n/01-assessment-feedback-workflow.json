                                         "jsCode":  "const crypto = require(\u0027crypto\u0027);\nconst item = $input.first();\nconst body = item.json.body;\nconst feedbackId = crypto.randomUUID();\nconst MAX_JSON_BYTES = 8192;\nconst MAX_NOTES = 2000;\nconst LABEL_SOURCES = [\u0027farmer_report\u0027, \u0027expert_verified\u0027, \u0027field_observed\u0027];\nconst OUTCOMES = [\u0027recovered\u0027, \u0027improving\u0027, \u0027no_change\u0027, \u0027worsening\u0027, \u0027spread_to_other_plants\u0027, \u0027crop_loss\u0027, \u0027unknown\u0027];\nconst UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nfunction fail(status, code, message, details) {\n  const err = { code: code, message: message, requestId: feedbackId };\n  if (details \u0026\u0026 details.length) err.details = details;\n  return [{ json: { valid: false, httpStatus: status, response: { error: err } } }];\n}\nif (!body || typeof body !== \u0027object\u0027 || Array.isArray(body)) {\n  return fail(400, \u0027INVALID_REQUEST\u0027, \u0027A JSON object body is required.\u0027);\n}\nconst size = Buffer.byteLength(JSON.stringify(body), \u0027utf8\u0027);\nif (size \u003e MAX_JSON_BYTES) {\n  return fail(413, \u0027PAYLOAD_TOO_LARGE\u0027, \u0027The request body exceeds \u0027 + MAX_JSON_BYTES + \u0027 bytes.\u0027);\n}\nconst problems = [];\nfunction optStr(v, name, max) {\n  if (v === undefined || v === null || v === \u0027\u0027) return null;\n  if (typeof v !== \u0027string\u0027) { problems.push(name + \u0027 must be a string\u0027); return null; }\n  const t = v.replace(/[\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]/g, \u0027\u0027).trim();\n  if (t.length \u003e max) { problems.push(name + \u0027 must be at most \u0027 + max + \u0027 characters\u0027); return null; }\n  return t === \u0027\u0027 ? null : t;\n}\nconst assessmentId = typeof body.assessmentId === \u0027string\u0027 ? body.assessmentId.trim() : \u0027\u0027;\nif (!assessmentId) problems.push(\u0027assessmentId is required\u0027);\nelse if (!UUID_RE.test(assessmentId)) problems.push(\u0027assessmentId must be a valid UUID\u0027);\n\nconst labelSource = typeof body.labelSource === \u0027string\u0027 ? body.labelSource.trim() : \u0027\u0027;\nif (LABEL_SOURCES.indexOf(labelSource) === -1) problems.push(\u0027labelSource must be one of: \u0027 + LABEL_SOURCES.join(\u0027, \u0027));\n\nlet diseaseObserved = body.diseaseObserved;\nif (diseaseObserved === true) diseaseObserved = \u0027true\u0027;\nelse if (diseaseObserved === false) diseaseObserved = \u0027false\u0027;\nelse if (diseaseObserved !== \u0027unknown\u0027) { problems.push(\u0027diseaseObserved must be true, false or \"unknown\"\u0027); diseaseObserved = null; }\n\nconst outcomeStatus = typeof body.outcomeStatus === \u0027string\u0027 ? body.outcomeStatus.trim() : \u0027\u0027;\nif (OUTCOMES.indexOf(outcomeStatus) === -1) problems.push(\u0027outcomeStatus must be one of: \u0027 + OUTCOMES.join(\u0027, \u0027));\n\nlet days = null;\nif (body.daysAfterAssessment !== undefined \u0026\u0026 body.daysAfterAssessment !== null) {\n  const d = body.daysAfterAssessment;\n  if (typeof d !== \u0027number\u0027 || !Number.isInteger(d) || d \u003c 0 || d \u003e 730) problems.push(\u0027daysAfterAssessment must be an integer between 0 and 730\u0027);\n  else days = d;\n}\nlet helpful = null;\nif (body.farmerFoundAdvisoryHelpful !== undefined \u0026\u0026 body.farmerFoundAdvisoryHelpful !== null) {\n  if (typeof body.farmerFoundAdvisoryHelpful !== \u0027boolean\u0027) problems.push(\u0027farmerFoundAdvisoryHelpful must be a boolean\u0027);\n  else helpful = body.farmerFoundAdvisoryHelpful;\n}\nconst observedCropType = optStr(body.observedCropType, \u0027observedCropType\u0027, 100);\nconst confirmedDisease = optStr(body.confirmedDisease, \u0027confirmedDisease\u0027, 200);\nconst notes = optStr(body.notes, \u0027notes\u0027, MAX_NOTES);\nif (problems.length) return fail(400, \u0027INVALID_REQUEST\u0027, \u0027The request is invalid.\u0027, problems);\n\nconst hashInput = JSON.stringify([assessmentId, labelSource, observedCropType, confirmedDisease, diseaseObserved, outcomeStatus, days, helpful, notes]);\nconst payloadHash = crypto.createHash(\u0027sha256\u0027).update(hashInput).digest(\u0027hex\u0027);\nreturn [{ json: {\n  valid: true, feedbackId: feedbackId, assessmentId: assessmentId.toLowerCase(), labelSource: labelSource,\n  observedCropType: observedCropType, confirmedDisease: confirmedDisease, diseaseObserved: diseaseObserved,\n  outcomeStatus: outcomeStatus, daysAfterAssessment: days, farmerFoundAdvisoryHelpful: helpful,\n  notes: notes, payloadHash: payloadHash, receivedAt: new Date().toISOString()\n} }];"
